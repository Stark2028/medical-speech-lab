# Append this block to /opt/saga/deploy/aws/Caddyfile on the shared host.
# Keep the existing SagaAgent site block in place.
medical-speech-lab.65.0.103.235.sslip.io {
    encode zstd gzip
    request_body {
        max_size 8MB
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
    reverse_proxy medical-speech-lab-api:8000
}
